# Do not add your user, or any others, to this group.
GROUP_NAME="onepassword"
POLICY_TEMPLATE="/usr/share/1password/com.1password.1Password.policy.tpl"
POLICY_FILE="/usr/share/polkit-1/actions/com.1password.1Password.policy"

app_group_exists() {
    getent group "${GROUP_NAME}" >/dev/null
}

setup_browser_helper() {
    # Setup the Core App Integration helper binary with the correct permissions and group
    BROWSER_SUPPORT_PATH="/opt/1Password/1Password-BrowserSupport"

    chgrp "${GROUP_NAME}" "$BROWSER_SUPPORT_PATH"
    chmod g+s "$BROWSER_SUPPORT_PATH"
}

install_polkit_policy() {
    local passwd_file=${1:-/etc/passwd}
    local template=${2:-$POLICY_TEMPLATE}
    local policy_file=${3:-$POLICY_FILE}
    local policy_dir policy_owners escaped_owners tmp

    if [ ! -r "$template" ]; then
        printf 'warning: 1Password Polkit template is missing: %s\n' "$template" >&2
        return 1
    fi

    # Match 1Password's installer: authorize at most the first ten users whose
    # UID has exactly four digits. This runs on the target machine, so temporary
    # CI users can never be written into the installed policy.
    policy_owners=$(awk -F: '
        $3 ~ /^[0-9][0-9][0-9][0-9]$/ && count < 10 {
            printf "unix-user:%s ", $1
            count++
        }
    ' "$passwd_file")

    # Escape sed replacement metacharacters. Unlike the vendor script, this does
    # not eval the template as shell code while running as root.
    escaped_owners=${policy_owners//\\/\\\\}
    escaped_owners=${escaped_owners//&/\\&}
    escaped_owners=${escaped_owners//|/\\|}

    policy_dir=${policy_file%/*}
    install -d -m0755 "$policy_dir"
    tmp=$(mktemp "${policy_file}.tmp.XXXXXX") || return 1
    if ! sed "s|\${POLICY_OWNERS}|${escaped_owners}|g" "$template" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 0644 "$tmp"
    mv -f "$tmp" "$policy_file"
}

pre_install() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

pre_upgrade() {
    if app_group_exists; then
        : # Do nothing
    else
        groupadd "${GROUP_NAME}"
    fi
}

post_install() {
    setup_browser_helper
    install_polkit_policy
}

post_upgrade() {
    setup_browser_helper
    install_polkit_policy
}

post_remove() {
    rm -f "$POLICY_FILE"
    if app_group_exists; then
        groupdel "${GROUP_NAME}"
    fi
}
